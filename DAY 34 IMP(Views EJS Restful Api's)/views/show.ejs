<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post in detail</title>
</head>
<body>
    <h2>Here is a post in detail</h2>
    <p>
        post id : <%= post.id %>
    </p>

    <div class="post">
        <h3 class="user"><%= post.username %></h3>
        <h4><%= post.content %></h4>
    </div>
</body>
</html>