<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create new chat</title>
</head>
<body>
    <h3>Create new chat</h3>
    <form method="post" action="/new">
        <br>
        <input type="text" name="from" placeholder="Enter your name">
        <br>
        <br>
        <textarea name="msg" placeholder="Enter your message here ...."></textarea>
        <br>
        <br>
        <input type="text" name="to" placeholder="to send">
        <br>
        <br>
        <button>Create</button>
    </form>
</body>
</html>